{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["enabled", "app", "sbu", "fullname", "image", "host", "port", "command", "readinessPath", "resources", "env", "sourceSecrets"],
  "properties": {
    "enabled": {"type": "boolean"},
    "app": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,28}[a-z0-9]$"},
    "sbu": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "fullname": {"type": "string", "maxLength": 53},
    "image": {"type": "string"},
    "release": {"type": ["integer", "null"]},
    "host": {"type": "string"},
    "port": {"type": "integer"},
    "command": {"type": "array", "items": {"type": "string"}},
    "readinessPath": {"type": "string"},
    "resources": {"type": "object"},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "sourceSecrets": {"type": "array", "items": {"type": "string", "pattern": "^ctzd-source-[a-z0-9-]+$"}},
    "ingressClassName": {"type": "string"},
    "tlsSecretName": {"type": "string"},
    "smtpConfigMapName": {"type": "string"},
    "serviceAccountName": {"type": "string"},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}, "url": {"type": "string"}, "signin": {"type": "string"}}
    }
  }
}
